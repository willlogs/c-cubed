{
  "name": "command-center",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Runs a project with a team of Claude Code sessions: an assistant for the owner, a master that reviews and merges, and one worker per issue.",
  "bin": {
    "command-center": "bin/command-center.mjs"
  },
  "scripts": {
    "prestart": "npm ls --depth=0 >/dev/null 2>&1 || npm ci --no-audit --no-fund --loglevel=error",
    "start": "node server/main.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0",
    "typescript": "5.9.3",
    "ws": "8.22.0"
  }
}
